<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.heinu1.wechat-bot</string>

  <key>ProgramArguments</key>
  <array>
    <string>__BOT_DIR__/start.sh</string>
  </array>

  <!-- 开机自动启动 -->
  <key>RunAtLoad</key>
  <true/>

  <!-- 无条件保活：不管为何退出（崩溃 / 干净退出 code 0 / 睡眠时 SIGTERM / 网络中断），
       launchd 都立即拉起；睡眠→唤醒后若进程已死也会自动重启。
       彻底停 bot：`launchctl bootout gui/$(id -u)/com.heinu1.wechat-bot`。 -->
  <key>KeepAlive</key>
  <true/>

  <!-- ThrottleInterval 10：两次重启至少间隔 10s，防止死循环狂重启 -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>WorkingDirectory</key>
  <string>__BOT_DIR__</string>

  <key>StandardOutPath</key>
  <string>__HOME__/.heinu1-bot/bot.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/.heinu1-bot/bot.error.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <!-- 如需修改权限模式：bypassPermissions / acceptEdits / default -->
    <key>CLAUDE_PERMISSION_MODE</key>
    <string>bypassPermissions</string>
  </dict>
</dict>
</plist>
